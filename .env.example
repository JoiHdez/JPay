# Reap Agentic Payments (sandbox). Sin REAP_API_KEY el servicio corre en modo simulado,
# con respuestas que imitan las de Reap, para poder ensayar la demo sin red.
REAP_API_KEY=
REAP_BASE=https://sandbox.api.reap.global
# El sandbox solo acepta 2025-02-14 (probado el 2026-10-09).
REAP_VERSION=2025-02-14
# Tienda de EE. UU. de la lista de comercios compatibles y una direccion a la que entregue.
REAP_PAIS=US
REAP_MONEDA=USD
REAP_EMAIL=demo@ochavo.com.mx
REAP_ENVIO={"firstName":"Demo","lastName":"Ochavo","phone":"+12127363100","addressLine1":"350 5th Ave","addressLine2":"Floor 1","city":"New York","postalCode":"10118","country":"US"}

# Ochavo: token de Integraciones > API Tokens con permisos read, write, budgets y expenses.
OCHAVO_URL=https://ochavo.com.mx
OCHAVO_TOKEN=
OCHAVO_CATEGORIA=Supermercado

# Si no responde la API de tipo de cambio, se usa este valor.
TC_USD_MXN=

# Reap pide una URL HTTPS de regreso: en el evento, la del tunel (cloudflared o ngrok).
PUBLIC_URL=http://localhost:3010
PORT=3010
