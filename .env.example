# Reap Agentic Payments (sandbox). Sin REAP_API_KEY el servicio corre en modo simulado,
# con respuestas que imitan las de Reap, para ensayar la demo sin red.
REAP_API_KEY=
REAP_BASE=https://sg.sandbox.api.reap.global
# El sandbox solo acepta 2025-02-14 (probado el 2026-10-09).
REAP_VERSION=2025-02-14
# Opcional: si ya registraste la tarjeta, su enrollment ID. Si no, se guarda en data/jpay.json.
REAP_ENROLLMENT_ID=

# Compras en tiendas de EE. UU. de la lista de comercios compatibles, con una direccion a la que
# entreguen. Algunas tiendas exigen telefono valido y addressLine2.
REAP_PAIS=US
REAP_MONEDA=USD
REAP_EMAIL=compras@jpay.demo
REAP_ENVIO={"firstName":"Compras","lastName":"JPay","phone":"+12127363100","addressLine1":"350 5th Ave","addressLine2":"Floor 1","city":"New York","region":"NY","postalCode":"10118","country":"US"}

# Claude (opcional): interpreta el pedido en lenguaje natural del solicitante. Sin ella, ese
# cuadro responde 501 y el formulario normal sigue funcionando.
ANTHROPIC_API_KEY=

# MongoDB con la lista oficial de comercios (npm run importar:comercios). Local para desarrollo;
# para compartir con el equipo, la URI de un cluster en la nube.
MONGODB_URI=mongodb://localhost:27017/jpay

# Reap exige una URL HTTPS de regreso: la del tunel (cloudflared tunnel --url http://localhost:3010).
PUBLIC_URL=http://localhost:3010
PORT=3010
